#!/usr/bin/env bash
# ARASAKA // toca o som de entrada ao iniciar a sessao.
sleep 1.5
snd=/usr/share/sounds/Arasaka/stereo/desktop-login.wav
if command -v canberra-gtk-play >/dev/null 2>&1; then
  canberra-gtk-play -i desktop-login -d "Arasaka login" && exit 0
fi
for p in pw-play paplay aplay; do
  if command -v "$p" >/dev/null 2>&1; then
    "$p" "$snd" >/dev/null 2>&1 && exit 0
  fi
done
exit 0
